{
  "$schema": "https://v2-10-11.turborepo.dev/schema.json",
  "globalDependencies": [
    ".env"
  ],
  "globalPassThroughEnv": [
    "PUBLIC_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_DB_PATH",
    "SYSTEM_KEY",
    "ADMIN_PASSPHRASE",
    "STORAGE_ROOT",
    "DB_URL"
  ],
  "globalEnv": [
    "PUBLIC_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_DB_PATH",
    "SYSTEM_KEY",
    "ADMIN_PASSPHRASE",
    "STORAGE_ROOT",
    "DB_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "dist/**",
        "build/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^test"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}