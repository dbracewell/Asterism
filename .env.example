# Strict syntax: unquoted KEY=VALUE only. Values cannot contain whitespace,
# quotes, $, #, backslashes, interpolation, or inline comments. See README.md.

# The only public origin setting. No trailing slash.
PUBLIC_URL=http://localhost:3000

# Generate distinct persistent secrets with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-strong-random-secret
SYSTEM_KEY=replace-with-another-strong-random-secret
ADMIN_PASSPHRASE=replace-with-a-strong-admin-passphrase

# Local development only: use an absolute, writable directory.
# Docker Compose always uses its named volume mounted at /storage.
STORAGE_ROOT=/absolute/path/to/asterism-storage

# Optional host port for Docker Compose; update PUBLIC_URL to match.
# PORT=3000

# Advanced storage overrides (normally unnecessary):
# BETTER_AUTH_DB_PATH=/absolute/path/to/users.db
# DB_URL=sqlite+aiosqlite:////absolute/path/to/database.db
