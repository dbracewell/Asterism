{
  "mermaid": {
    "startOnLoad": false,
    "securityLevel": "strict",
    "htmlLabels": false,
    "suppressErrorRendering": true,
    "maxTextSize": 20000,
    "maxEdges": 500,
    "fontFamily": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "flowchart": { "wrappingWidth": 200 },
    "state": { "wrappingWidth": 200 },
    "themeCSS": ".edgeLabel rect { opacity: 1 !important; }",
    "secure": [
      "secure",
      "securityLevel",
      "startOnLoad",
      "maxTextSize",
      "maxEdges",
      "suppressErrorRendering",
      "htmlLabels",
      "dompurifyConfig",
      "theme",
      "themeVariables",
      "themeCSS",
      "darkMode",
      "fontFamily",
      "altFontFamily",
      "look"
    ]
  },
  "renderTimeoutMs": 8000,
  "sanitizer": {
    "profiles": { "svg": true, "svgFilters": true },
    "addTags": ["style"],
    "forbidTags": ["foreignObject", "image", "a", "script", "use"],
    "forbidAttributes": ["onload", "onerror", "onclick"],
    "internalHrefPrefix": "#"
  },
  "png": { "scale": 2, "maxSide": 8192 },
  "labelLimits": { "name": 300, "description": 2000 }
}
