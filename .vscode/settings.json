{
  "files.watcherExclude": {
    "**/routeTree.gen.ts": true
  },
  "search.exclude": {
    "**/routeTree.gen.ts": true,
    "**/node_modules": true,
    "**/.venv": true,
    ".ruff_cache": true,
    ".idea": true
  },
  "files.readonlyInclude": {
    "**/routeTree.gen.ts": true
  },
  "basedpyright.analysis.configFilePath": "${workspaceFolder}/apps/backend/pyproject.toml",
  "cSpell.words": ["dotenv", "sessionmaker", "sessionmanager", "zoomable"],
  "python-envs.pythonProjects": [
    {
      "path": "apps/backend",
      "envManager": "ms-python.python:venv",
      "packageManager": "ms-python.python:pip",
      "extraPaths": ["${workspaceFolder}/apps/backend"]
    }
  ],
  "basedpyright.analysis.autoImportCompletions": true,
  "basedpyright.analysis.extraPaths": ["${workspaceFolder}/apps/backend"],
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/routeTree.gen.ts": true,
    "**/node_modules": true,
    "**/.venv": true,
    "**/.ruff_cache": true,
    "**/.pytest_cache": true,
    "**/.next": true,
    ".idea": true
  },
  "python.languageServer": "None",
  "pendant.runtimeSource": "bundled",
  "pendant.showThinking": true,
  "pendant.thinkingDisplayMode": "collapseWhenDone",
  "pendant.notifications.agentFinished": true,
  "pendant.diagnostics.enabled": false
}
