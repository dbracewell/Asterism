{
  "files.watcherExclude": {
    "**/routeTree.gen.ts": true
  },
  "search.exclude": {
    "**/routeTree.gen.ts": true,
    "**/node_modules": true,
    "**/.venv": true,
    ".ruff_cache": true,
    ".idea": true
  },
  "files.readonlyInclude": {
    "**/routeTree.gen.ts": true
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/apps/backend/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "cSpell.words": ["dotenv", "sessionmaker", "sessionmanager", "zoomable"],
  "python-envs.pythonProjects": [
    {
      "path": "apps/backend",
      "envManager": "ms-python.python:venv",
      "packageManager": "ms-python.python:pip",
      "extraPaths": ["${workspaceFolder}/apps/backend"]
    }
  ],
  "basedpyright.analysis.autoImportCompletions": true,
  "basedpyright.analysis.extraPaths": ["${workspaceFolder}/apps/backend"],
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/routeTree.gen.ts": true,
    "**/node_modules": true,
    "**/.venv": true,
    "**/.ruff_cache": true,
    "**/.pytest_cache": true,
    "**/.next": true,
    ".idea": true
  },
  "python.analysis.languageServerMode": "full",
  "python.languageServer": "None",
  "python.analysis.typeCheckingMode": "off",
  "pendant.runtimeSource": "bundled"
}
